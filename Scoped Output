# ============================================================ 

# Microsoft Entra Custom Enterprise Application Claims Audit (Combined, Collapsible HTML Report) 

# Purpose: 

# Discovers service principals classified by the Microsoft Entra admin center as Enterprise Applications.

# The inventory is limited to objects tagged as WindowsAzureActiveDirectoryIntegratedApp,
# matching the portal filter Application type == Enterprise Application.
# Claims configuration is then audited only for that filtered application set.

# 1. Basic application information 

# 2. Attributes & Claims / Custom Claims Policy configuration 

# 3. Any Claims Mapping Policy assigned to the application 

# The combined results are rendered into a single HTML report where each 

# application is its own collapsible (expand/collapse) section containing its 

# Attributes & Claims table and Claims Mapping Policy table. 

# Requirements: 

# - Microsoft Graph PowerShell SDK 

# - Application.Read.All 

# - Policy.Read.All 

# ============================================================ 

# Connect to Microsoft Graph with permissions required to 

# read Enterprise Applications and policy configuration. 

# Authenticate to Microsoft Graph using read-only application and policy scopes. 

Connect-MgGraph -Scopes "Application.Read.All","Policy.Read.All" 

# Prompt for the file path where the HTML audit report will be saved. 

# Require a non-empty destination path from the operator. 

do { $ReportPath = Read-Host "Enter full file path to save the HTML report (e.g. C:\Reports\EnterpriseAppAudit.html)" } while ([string]::IsNullOrWhiteSpace($ReportPath)) 

# Ensure the report has an .html extension. 

# Append the HTML extension when the supplied path omits it. 

if ($ReportPath -notmatch '.html?$') { $ReportPath = "$ReportPath.html" } 

# Make sure the destination folder exists. 

# Resolve the parent directory from the requested report path. 

$ReportFolder = Split-Path -Path $ReportPath -Parent 

# Create the destination directory when it does not already exist. 

if ($ReportFolder -and -not (Test-Path $ReportFolder)) { New-Item -ItemType Directory -Path $ReportFolder -Force | Out-Null } 

# ------------------------------------------------------------ 

# Discover Enterprise Applications

# ------------------------------------------------------------ 

# Enterprise Applications are represented in Microsoft Entra ID as service principal objects.
# The portal classification is identified by the WindowsAzureActiveDirectoryIntegratedApp tag.
# Restrict the inventory to that tag so managed identities, Microsoft applications,
# and other service-principal types are excluded from the report.
# This matches Application type == Enterprise Application in the Entra admin center.



# are considered "custom" Enterprise Applications for this audit. 

# Notify the operator before tenant-wide service-principal retrieval begins. 

Write-Host "Retrieving Enterprise Applications from the tenant..." -ForegroundColor Cyan 

# Retrieve only service principals tagged as Enterprise Applications.
# -All follows pagination so the full filtered inventory is returned.
# Request the properties used by the report and the portal classification tag.



$AllServicePrincipals = Get-MgServicePrincipal -Filter "tags/any(t:t eq 'WindowsAzureActiveDirectoryIntegratedApp')" -Property "id,appId,displayName,tags" -All

# Use the Enterprise Application-tagged service-principal collection.

# Do not apply additional gallery, publisher, or ownership exclusions.

# Claims configuration can exist on gallery, third-party, or tenant-created enterprise apps.

# The HTML report includes every matching Enterprise Application and exposes retrieval errors.





# Sort the filtered Enterprise Application inventory by display name.

$CustomApps = @($AllServicePrincipals | Sort-Object DisplayName) 

# Stop cleanly when the tenant contains no application service principals. 

if (-not $CustomApps -or $CustomApps.Count -eq 0) { Write-Host "No Enterprise Applications were found in this tenant." -ForegroundColor Yellow; return }

# Display the number of applications that will be evaluated. 

Write-Host "Found $($CustomApps.Count) Enterprise Application(s). Auditing..." -ForegroundColor Cyan

# ------------------------------------------------------------ 

# Audit Each Enterprise Application

# ------------------------------------------------------------ 

# For each custom application, collect basic info, the Attributes 

# & Claims / Custom Claims Policy configuration, and any assigned 

# Claims Mapping Policy. Results are accumulated into $AuditResults 

# for later rendering into the combined, collapsible HTML report. 

# Initialize the progress counter. 

$AppIndex = 0 

# Build one audit result object for every application service principal. 

$AuditResults = foreach ($SP in $CustomApps) { 

# Advance the current application counter. 

    $AppIndex++ 

# Calculate progress as a percentage of the complete inventory. 

    $PercentComplete = [math]::Round(($AppIndex / $CustomApps.Count) * 100) 

# Display the application currently being processed. 

    Write-Progress -Activity "Auditing Enterprise Applications" -Status "Processing $AppIndex of $($CustomApps.Count): $($SP.DisplayName)" -PercentComplete $PercentComplete

    # Track retrieval failures separately from a valid empty policy response. 
    $ClaimsError = $null 
    try { 
        # Retrieve the custom claims policy configured through Attributes & Claims. 
        $ClaimsPolicy = Invoke-MgGraphRequest -Method GET -Uri "https://graph.microsoft.com/beta/servicePrincipals/$($SP.Id)/claimsPolicy" -ErrorAction Stop 
        # Normalize the claims collection so zero, one, or many claims are handled consistently. 
        $ClaimRows = foreach ($Claim in @($ClaimsPolicy.claims)) { 
            foreach ($Config in @($Claim.configurations)) { 
                # Read the source directory attribute used to populate this claim. 
                $Attribute = $Config.attribute.id 
                if (-not $Attribute) { $Attribute = "-" } 
                # Preserve a readable summary of any configured claim transformations. 
                if ($Config.transformations -and $Config.transformations.Count -gt 0) { 
                    $Transformation = ($Config.transformations | ForEach-Object { 
                        if ($_.name) { $_.name } 
                        elseif ($_.id) { $_.id } 
                        elseif ($_.'@odata.type') { $_.'@odata.type' -replace '#microsoft.graph.', '' } 
                        else { "Transformation configured" } 
                    }) -join ", " 
                } else { 
                    $Transformation = "-" 
                } 
                [PSCustomObject]@{ 
                    Claim = $Claim.name 
                    SourceAttribute = if ($Attribute -eq "-") { "-" } else { "user.$Attribute" } 
                    Transformation = $Transformation 
                } 
            } 
        } 
    } catch { 
        # Keep processing other applications and surface the failure in the HTML report. 
        $ClaimRows = @() 
        $ClaimsError = $_.Exception.Message 
    } 

    # Retrieve assigned claims-mapping policies and explicitly request definitions. 
    # Initialize an empty collection for normalized mapping-policy rows. 
    $MappingRows = @() 
    $MappingError = $null 
    try { 
        # Query the service-principal relationship and request each policy definition. 
        $MappingResponse = Invoke-MgGraphRequest -Method GET -Uri "https://graph.microsoft.com/v1.0/servicePrincipals/$($SP.Id)/claimsMappingPolicies?`$select=id,displayName,definition" -ErrorAction Stop 
        # Normalize the Graph response collection before enumeration. 
        $MappingPolicies = @($MappingResponse.value) 
        foreach ($Policy in $MappingPolicies) { 
            foreach ($Definition in @($Policy.definition)) { 
                # Deserialize the policy definition string into an inspectable object. 
                $Def = $Definition | ConvertFrom-Json 
                # Flatten every ClaimsSchema entry into a report-friendly row. 
                foreach ($Schema in @($Def.ClaimsMappingPolicy.ClaimsSchema)) { 
                    $MappingRows += [PSCustomObject]@{ 
                        PolicyName = $Policy.displayName 
                        Claim = if ($Schema.SamlClaimType) { $Schema.SamlClaimType } else { $Schema.JwtClaimType } 
                        Source = $Schema.Source 
                        Attribute = if ($Schema.ID) { $Schema.ID } else { $Schema.ExtensionID } 
                    } 
                } 
            } 
        } 
    } catch { 
        # Preserve the failure for display without stopping the tenant-wide audit. 
        $MappingError = $_.Exception.Message 
    } 

# ------------------------------------------------------------ 
# Emit one consolidated result object per application for 
# the combined HTML report, even when no claims or mapping 
# policy rows were found (so every application still appears). 
# ------------------------------------------------------------ 
[PSCustomObject]@{ 
    DisplayName     = $SP.DisplayName 
    ObjectId        = $SP.Id 
    AppId           = $SP.AppId 
    Claims          = $ClaimRows 
    MappingPolicies = $MappingRows 
    ClaimsError     = $ClaimsError 
    MappingError    = $MappingError 
} 

} 

# Clear the progress indicator after all applications are processed. 

Write-Progress -Activity "Auditing Enterprise Applications" -Completed

# ------------------------------------------------------------ 

# Build the Combined, Collapsible HTML Report 

# ------------------------------------------------------------ 

# Each custom Enterprise Application becomes its own collapsible 

# section (an HTML <details>/<summary> element). Expanding a 

# section reveals that application's Attributes & Claims table 

# and its Claims Mapping Policy table. 

# Notify the operator that report rendering has started. 

Write-Host "Building HTML report..." -ForegroundColor Cyan 

$GeneratedOn = Get-Date -Format "yyyy-MM-dd HH:mm:ss" 
 
$HtmlHead = @" 
<!DOCTYPE html> 
<html> 
<head> 
<meta charset="UTF-8"> 
<title>Microsoft Entra Enterprise Application Claims Audit</title> 
<style> 
    body { font-family: Segoe UI, Arial, sans-serif; margin: 24px; background-color: #f3f2f1; color: #201f1e; } 
    h1 { color: #0f4761; } 
    p.meta { color: #605e5c; margin-top: -8px; } 
    details { background-color: #ffffff; border: 1px solid #d2d0ce; border-radius: 4px; margin-bottom: 10px; padding: 0; } 
    summary { cursor: pointer; font-weight: 600; font-size: 16px; padding: 12px 16px; background-color: #0f4761; color: #ffffff; border-radius: 4px; list-style: none; } 
    summary::-webkit-details-marker { display: none; } 
    summary:before { content: "+ "; } 
    details[open] summary:before { content: "- "; } 
    .app-body { padding: 12px 16px 16px 16px; } 
    .app-meta { font-size: 13px; color: #605e5c; margin-bottom: 10px; } 
    h3 { color: #0f4761; font-size: 14px; margin-bottom: 4px; } 
    table { border-collapse: collapse; width: 100%; margin-bottom: 16px; font-size: 13px; } 
    th, td { border: 1px solid #d2d0ce; padding: 6px 10px; text-align: left; } 
    th { background-color: #f3f2f1; color: #0f4761; } 
    tr:nth-child(even) { background-color: #faf9f8; } 
    .none { color: #a19f9d; font-style: italic; } 
    .error { color: #a4262c; font-weight: 600; } 
</style> 
<script> 
function toggleAll(expand) { 
    document.querySelectorAll("details").forEach(function (d) { d.open = expand; }); 
} 
</script> 
</head> 
<body> 
<h1>Microsoft Entra Enterprise Application Claims Audit</h1> 
<p class="meta">Generated: $GeneratedOn  |  Applications audited: $($CustomApps.Count)</p> 
<p><button onclick="toggleAll(true)">Expand All</button> <button onclick="toggleAll(false)">Collapse All</button></p> 
"@ 

# Build one collapsible section per application. 
$AppSections = foreach ($App in $AuditResults) { 
    # HTML-encode tenant-supplied values before inserting them into table cells. 
    $ClaimRowsHtml = ($App.Claims | ForEach-Object { 
        "<tr><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.Claim))</td><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.SourceAttribute))</td><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.Transformation))</td></tr>" 
    }) -join "`n" 
    # Render a table, a retrieval error, or an explicit empty-state message. 
    if ($ClaimRowsHtml) { 
        $ClaimsTableHtml = "<h3>Attributes & Claims / Custom Claims Policy</h3><table><tr><th>Claim</th><th>Source Attribute</th><th>Transformation</th></tr>$ClaimRowsHtml</table>" 
    } elseif ($App.ClaimsError) { 
        $ClaimsTableHtml = "<h3>Attributes & Claims / Custom Claims Policy</h3><p class=error>Retrieval failed: $([System.Net.WebUtility]::HtmlEncode([string]$App.ClaimsError))</p>" 
    } else { 
        $ClaimsTableHtml = "<h3>Attributes & Claims / Custom Claims Policy</h3><p class=none>No custom claims policy returned.</p>" 
    } 

    # Build the assigned claims-mapping policy section for this application. 
    # HTML-encode assigned-policy values before inserting them into table cells. 
    $MappingRowsHtml = ($App.MappingPolicies | ForEach-Object { 
        "<tr><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.PolicyName))</td><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.Claim))</td><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.Source))</td><td>$([System.Net.WebUtility]::HtmlEncode([string]$_.Attribute))</td></tr>" 
    }) -join "`n" 
    # Distinguish populated, failed, and unassigned mapping-policy results. 
    if ($MappingRowsHtml) { 
        $MappingTableHtml = "<h3>Claims Mapping Policy</h3><table><tr><th>Policy Name</th><th>Claim</th><th>Source</th><th>Attribute</th></tr>$MappingRowsHtml</table>" 
    } elseif ($App.MappingError) { 
        $MappingTableHtml = "<h3>Claims Mapping Policy</h3><p class=error>Retrieval failed: $([System.Net.WebUtility]::HtmlEncode([string]$App.MappingError))</p>" 
    } else { 
        $MappingTableHtml = "<h3>Claims Mapping Policy</h3><p class=none>None assigned.</p>" 
    } 

    # ---------------------------------------------------- 
    # Wrap this application's tables in a collapsible 
    # <details>/<summary> section so the report stays 
    # readable when auditing many applications. 
    # ---------------------------------------------------- 
    # Emit the application name as the clickable summary and place both result sections below it. 
    @" 
<details> 
<summary>$($App.DisplayName)</summary> 
<div class="app-body"> 
<div class="app-meta">Object ID: $($App.ObjectId)  |  App ID: $($App.AppId)</div> 
$ClaimsTableHtml 
$MappingTableHtml 
</div> 
</details> 
"@ 
} 

# ------------------------------------------------------------ 

# Assemble and Save the Combined HTML Report 

# ------------------------------------------------------------ 

# Close the HTML document after all application sections are generated. 
$HtmlFooter = "</body>`n</html>" 
 
# Join the page header, collapsible application sections, and footer. 
$FullHtml = $HtmlHead + "`n" + ($AppSections -join "`n") + "`n" + $HtmlFooter 
 
# Write UTF-8 output so claim names and application names remain readable. 
$FullHtml | Out-File -FilePath $ReportPath -Encoding UTF8 

# Confirm the report destination after the file is written. 

Write-Host "Report saved to: $ReportPath" -ForegroundColor Green 

# Open the completed report in the default browser. 

# Open the completed report using the system default browser. 

Invoke-Item $ReportPath 

